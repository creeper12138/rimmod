<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <HediffDef>
    <defName>Nexus_SystemOverclock</defName>
    <label>Nexus网络超频</label>
    <description>当前区域的网络信号极强，反应速度和计算能力大幅提升。</description>
    <hediffClass>HediffWithComps</hediffClass>
    <defaultLabelColor>(0.6, 0.8, 1.0)</defaultLabelColor> <isBad>false</isBad> <stages>
      <li>
        <capMods>
          <li>
            <capacity>Consciousness</capacity>
            <offset>0.20</offset> </li>
          <li>
            <capacity>Moving</capacity>
            <offset>0.15</offset> </li>
        </capMods>
        <statOffsets>
            <WorkSpeedGlobal>0.25</WorkSpeedGlobal> <ShootingAccuracyPawn>2</ShootingAccuracyPawn> </statOffsets>
      </li>
    </stages>
  </HediffDef>

  <ThoughtDef>
    <defName>Nexus_NeuralStatic</defName>
    <workerClass>tsmod.ThoughtWorker_NexusStatic</workerClass> <stages>
      <li>
        <label>网络静电噪音</label>
        <description>我的头盖骨里好像有几千只蜜蜂在嗡嗡作响... </description>
        <baseMoodEffect>-8</baseMoodEffect> </li>
    </stages>
  </ThoughtDef>


<ThingDef>
    <defName>Nexus_TimeBubble</defName>
    <label>chronal field</label>
    <thingClass>tsmod.Nexus_TimeBubble</thingClass> <category>Ethereal</category>
    <tickerType>Normal</tickerType> <useHitPoints>false</useHitPoints>
    <selectable>false</selectable>
    <drawerType>None</drawerType> </ThingDef>



  <HediffDef>
    <defName>Nexus_TimeHaste</defName>
    <label>时空加速</label>
    <description>处于时间加速场中。</description>
    <hediffClass>HediffWithComps</hediffClass>
    <defaultLabelColor>(0.5, 0.8, 1.0)</defaultLabelColor>
    <isBad>false</isBad>
    <maxSeverity>1.0</maxSeverity>
    <comps>
      <li Class="HediffCompProperties_SeverityPerDay">
        <severityPerDay>-200.0</severityPerDay> 
      </li>
    </comps>
    <stages>
      <li>
        <statFactors>
          <WorkSpeedGlobal>5.0</WorkSpeedGlobal>
          <MoveSpeed>3.0</MoveSpeed>
          <GlobalLearningFactor>5.0</GlobalLearningFactor>
          <RestRateMultiplier>5.0</RestRateMultiplier>
        </statFactors>
      </li>
    </stages>
  </HediffDef>

  <HediffDef>
    <defName>Nexus_TimeStress_Hidden</defName>
    <label>时空压力</label>
    <description>时间流对生理结构的微观压迫。</description>
    <hediffClass>HediffWithComps</hediffClass>
    <isBad>true</isBad>
    <maxSeverity>1.1</maxSeverity> <stages>
      <li>
        <becomeVisible>false</becomeVisible> <minSeverity>0.01</minSeverity>
      </li>
    </stages>
    <comps>
      <li Class="HediffCompProperties_SeverityPerDay">
        <severityPerDay>-2.0</severityPerDay> 
      </li>
    </comps>
  </HediffDef>

  <HediffDef>
    <defName>Nexus_ChronalShock</defName>
    <label>震颤</label>
    <description>由于过度承受非线性时间流，神经突触发生断裂。受害者意识模糊，必须长时间静养以重建神经连接。</description>
    <hediffClass>HediffWithComps</hediffClass>
    <defaultLabelColor>(1.0, 0.2, 0.2)</defaultLabelColor> <isBad>true</isBad>
    <maxSeverity>1.0</maxSeverity>
    <comps>
      <li Class="HediffCompProperties_SeverityPerDay">
        <severityPerDay>-0.3</severityPerDay> 
      </li>
    </comps>
    <stages>
      <li>
        <capMods>
          <li><capacity>Consciousness</capacity><offset>-0.4</offset></li> <li><capacity>Moving</capacity><offset>-0.3</offset></li>        <li><capacity>Manipulation</capacity><offset>-0.3</offset></li>  </capMods>
        <painOffset>0.2</painOffset>
      </li>
    </stages>
  </HediffDef>


<HediffDef>
    <defName>Nexus_RewindCheck</defName>
    <label>data mirror active</label>
    <description>该殖民者正在进行数据镜像。如果在接下来 24 小时内遭受重创，其状态将回溯到镜像创建时刻。</description>
    
    <hediffClass>HediffWithComps</hediffClass>
    <defaultLabelColor>(0.8, 0.5, 1.0)</defaultLabelColor>
    <isBad>false</isBad>
    <maxSeverity>1.0</maxSeverity>
    
    <comps>
      <li Class="tsmod.HediffCompProperties_RewindCheck" /> 
      
      <li Class="HediffCompProperties_SeverityPerDay">
        <severityPerDay>0</severityPerDay> 
      </li>
    </comps>

    <stages>
        </stages>
</HediffDef>


</Defs>