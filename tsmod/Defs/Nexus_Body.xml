<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <BodyDef>
    <defName>Nexus_Humanoid_Body</defName>
    <label>Nexus humanoid chassis</label>
    <corePart>
      <def>MechanicalThorax</def> 
      <customLabel>chassis</customLabel>
      <parts>
        
        <li>
          <def>MechanicalHead</def>
          <customLabel>sensor head</customLabel>
          <coverage>0.15</coverage> <groups>
            <li>HeadAttackTool</li>
          </groups>
        </li>

        <li>
          <def>MechanicalShoulder</def>
          <customLabel>left shoulder</customLabel>
          <coverage>0.12</coverage>
          <parts>
            <li>
              <def>MechanicalArm</def>
              <customLabel>left arm</customLabel>
              <coverage>0.85</coverage> <parts>
                <li>
                  <def>MechanicalHand</def>
                  <customLabel>left manipulator</customLabel>
                  <coverage>0.25</coverage> <groups>
                    <li>LeftHand</li>
                  </groups>
                </li>
              </parts>
            </li>
          </parts>
        </li>

        <li>
          <def>MechanicalShoulder</def>
          <customLabel>right shoulder</customLabel>
          <coverage>0.12</coverage>
          <parts>
            <li>
              <def>MechanicalArm</def>
              <customLabel>right arm</customLabel>
              <coverage>0.85</coverage>
              <parts>
                <li>
                  <def>MechanicalHand</def>
                  <customLabel>right manipulator</customLabel>
                  <coverage>0.25</coverage>
                  <groups>
                    <li>RightHand</li>
                  </groups>
                </li>
              </parts>
            </li>
          </parts>
        </li>

        <li>
          <def>MechanicalLeg</def>
          <customLabel>left leg</customLabel>
          <coverage>0.20</coverage>
          <parts>
            <li>
              <def>MechanicalFoot</def>
              <customLabel>left foot</customLabel>
              <coverage>0.20</coverage> </li>
          </parts>
        </li>

        <li>
          <def>MechanicalLeg</def>
          <customLabel>right leg</customLabel>
          <coverage>0.20</coverage>
          <parts>
            <li>
              <def>MechanicalFoot</def>
              <customLabel>right foot</customLabel>
              <coverage>0.20</coverage>
            </li>
          </parts>
        </li>

      </parts>
    </corePart>
  </BodyDef>

</Defs>