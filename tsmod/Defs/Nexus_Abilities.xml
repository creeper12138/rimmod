<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <AbilityDef>
    <defName>Nexus_Ability_MeteorStrike</defName>
    <label>天陨冲击</label>
    <description>化身为陨石冲向目标区域。</description>
    <iconPath>tsmod/783</iconPath>
    <cooldownTicksRange>1200</cooldownTicksRange>
    <abilityClass>Ability</abilityClass>
    <verbProperties>
      <verbClass>Verb_CastAbility</verbClass>
      <range>29.9</range>
      <warmupTime>0.5</warmupTime>
      <targetParams>
        <canTargetLocations>true</canTargetLocations>
        <canTargetPawns>true</canTargetPawns>
        <canTargetBuildings>true</canTargetBuildings>
      </targetParams>
    </verbProperties>
    
    <comps>
      <li Class="tsmod.CompProperties_JobTrigger">
        <jobDef>Nexus_Job_MeteorStrike</jobDef>
      </li>

      <li Class="tsmod.CompProperties_AbilityPointCost">
        <amount>4</amount> </li>
    </comps>
  </AbilityDef>


  <AbilityDef>
    <defName>Nexus_Ability_Airdrop</defName>
    <label>战术空投</label>
    <description>呼叫穿梭机撞击目标。</description>
    <iconPath>tsmod/936</iconPath>
    <cooldownTicksRange>600</cooldownTicksRange>
    
    <verbProperties>
      <verbClass>Verb_CastAbility</verbClass>
      <range>39.9</range>
      <warmupTime>1.0</warmupTime>
      <requireLineOfSight>false</requireLineOfSight>
      <targetParams>
        <canTargetLocations>true</canTargetLocations>
      </targetParams>
    </verbProperties>
    
    <comps>
      <li Class="tsmod.CompProperties_JobTrigger">
        <jobDef>Nexus_Job_Airdrop</jobDef>
      </li>

      <li Class="tsmod.CompProperties_AbilityPointCost">
        <amount>2</amount> </li>
    </comps>
  </AbilityDef>


  <ThingDef ParentName="OrbitalStrikeBase">
    <defName>Nexus_Sweeping_PowerBeam</defName>
    <label>nexus sweeping beam</label>
    <thingClass>tsmod.Nexus_SweepingBeam</thingClass> 
<tickerType>Normal</tickerType> 
<drawOffscreen>true</drawOffscreen>
    
    <comps>
    <li Class="CompProperties_AffectsSky">
      <skyColors>
        <sky>(1.0, 0.9, 0.6)</sky>
        <shadow>(0.8, 0.6, 0.4)</shadow>
        <overlay>(1.0, 0.9, 0.6)</overlay>
      </skyColors>
    </li>
    </comps>
  </ThingDef>


  <ThingDef ParentName="MoteBase">
    <defName>Nexus_SweepingBeamMote</defName>
    <thingClass>tsmod.Mote_SweepingBeam</thingClass> <altitudeLayer>Weather</altitudeLayer>
    <drawOffscreen>true</drawOffscreen>
    <mote>
      <solidTime>99999</solidTime> <fadeInTime>0.2</fadeInTime>
      <fadeOutTime>0.5</fadeOutTime>
    </mote>
    <graphicData>
      <texPath>Things/Mote/PowerBeam</texPath> <shaderType>MoteGlow</shaderType>
      <drawSize>100</drawSize>
    </graphicData>
  </ThingDef>



<ThingDef ParentName="OrbitalStrikeBase">
    <defName>Nexus_Recycle_Beam</defName>
    <label>industrial disassembly beam</label>
    <thingClass>tsmod.Nexus_RecycleBeam</thingClass>
    
    <comps>
      <li Class="RimWorld.CompProperties_OrbitalBeam">
        <width>15</width>
        <color>(1, 0.7, 0.2, 0.9)</color>
        <sound>OrbitalBeam</sound>
      </li>
    </comps>

    <projectile>
      <damageDef>Smoke</damageDef>
      <damageAmountBase>0</damageAmountBase>
    </projectile>

    <drawOffscreen>true</drawOffscreen>
  </ThingDef>


<ThingDef ParentName="OrbitalStrikeBase">
    <defName>Nexus_Truth_Beam</defName>
    <label>entropy reduction beam</label> <thingClass>tsmod.Nexus_TruthBeam</thingClass>

    <comps>
      <li Class="RimWorld.CompProperties_OrbitalBeam">
        <width>15</width>
        <color>(0.2, 0.9, 1.0, 0.9)</color> 
        <sound>OrbitalBeam</sound>
      </li>
    </comps>

    <projectile>
      <damageDef>Smoke</damageDef>
      <damageAmountBase>0</damageAmountBase>
    </projectile>

    <drawOffscreen>true</drawOffscreen>
  </ThingDef>

</Defs>